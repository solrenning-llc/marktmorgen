rea\": \"All page/process states and integration failures\",\n      \"status\": \"inventory made; complete AAA/manual evaluation pending\",\n      \"publicWording\": \"Every state a page can be in, such as empty, loading or failed: we have listed them, but a person has not yet reviewed each one at level AAA.\"\n    },\n    {\n      \"area\": \"Keyboard,focus,zoom,reflow,text spacing,orientation,drag alternatives\",\n      \"status\": \"existing checks cover selected journeys; full cross-route/device evidence pending\",\n      \"publicWording\": \"Keyboard use, the focus outline, zoom, narrow screens, wider text spacing, turning the screen and other ways to do what dragging does: checked on some tasks, not yet on every page and device.\"\n    },\n    {\n      \"area\": \"Screen readers and platform/browser compatibility\",\n      \"status\": \"pilot only: CI entry trial with NVDA (Windows) and VoiceOver (macOS) on /signin and /signin?to=login; not validated with JAWS, TalkBack, other pages or all OS/browser combinations\",\n      \"publicWording\": \"Screen readers: a short trial with NVDA on Windows and VoiceOver on a Mac covers the sign-up and log-in pages only. Other screen readers, such as JAWS and TalkBack, and other devices and browsers are not checked yet.\"\n    },\n    {\n      \"area\": \"Real people with different access needs\",\n      \"status\": \"not conducted; no participant research or contact claimed\",\n      \"publicWording\": \"Testing with people who have disabilities: not done yet.\"\n    },\n    {\n      \"area\": \"Cognitive usability,plain language,errors/help and media alternatives\",\n      \"status\": \"systematic human/content review pending\",\n      \"publicWording\": \"Easy-to-understand words, error messages, help, and text versions of video and audio: a full review by a person is not done yet.\"\n    },\n    {\n      \"area\": \"Performance and comparative outcomes\",\n      \"status\": \"no matched competitor timing,percentile,assistive-task or superiority evidence; needs controlled measurement\",\n      \"publicWording\": \"Speed on simple phones and slow networks: not measured in a controlled way yet. We make no claim that we are faster or better than anyone else.\"\n    },\n    {\n      \"area\": \"Creator field placeholders\",\n      \"evidence\": \"Shared .st-field placeholders now use --st-text at full opacity. Synthetic Chromium reads actual computed pseudo-element/background colours and opacity; normal text ratio>=7 for all4 themes x10 presets and textarea4 themes/custom yellow. Negative control rejects former faded Night text. No entire-page/assistive/user conformance claim.\",\n      \"status\": \"Partially addressed in delivery21; actual full journeys/custom background overrides remain open\",\n      \"publicWording\": \"The gray example text inside the studio's boxes: its contrast is checked in every built-in theme, but not yet on every page or with a creator's own background.\"\n    },\n    {\n      \"area\": \"Focus appearance for standard fields\",\n      \"evidence\": \"Standard .field controls receive an opaque3px deep outline plus3px white inner band,with Highlight outline under forced colors. Actual Tab screenshot differences are measured for3:1 change area outside the original control,including invalid/readonly/select fixtures and real sign-in widths. Custom fields,clipping/occlusion across every journey,all browsers/OS/assistive users still need review. Delivery20 extends same-pixel checks to .st-field on actual production palettes;see docs/accessibility-store-field-focus.md.\",\n      \"status\": \"Partially addressed in deliveries19/20; whole-product focus evaluation remains open\",\n      \"publicWording\": \"The outline that shows which box has the keyboard: checked on the sign-in page and the studio's boxes, not yet across the whole product.\"\n    }\n  ],\n  \"currentEvidence\": \"Existing synthetic Chrome flows cover selected studio/campaign/Path/agreements states at390/1280 with AA automation and explicit keyboard cases. Added secondary-text tests are narrow evidence only; see docs/accessibility-programme.md.\",\n  \"layoutTemplates\": [\n    {\n      \"source\": \"app/[handle]/layout.tsx\",\n      \"status\": \"not yet reviewed for this programme\"\n    },\n    {\n      \"source\": \"app/help/layout.tsx\",\n      \"status\": \"AAA review not completed\"\n    },\n    {\n      \"source\": \"app/layout.tsx\",\n      \"status\": \"not yet reviewed for this programme\"\n    },\n    {\n      \"source\": \"app/platform/[slug]/layout.tsx\",\n      \"status\": \"AAA review not completed\"\n    },\n    {\n      \"source\": \"app/signin/layout.tsx\",\n      \"status\": \"not yet reviewed for this programme\"\n    },\n    {\n      \"source\": \"app/studio/layout.tsx\",\n      \"status\": \"not yet reviewed for this programme\"\n    }\n  ],\n  \"routeInventory\": {\n    \"generator\": \"scripts/accessibility-route-inventory.mjs\",\n    \"scope\": \"Source templates and parameter shapes only. Existing review status is preserved; a route is not an exercised fixture or a passing accessibility test.\",\n    \"pageTemplates\": 140\n  }\n}\n"
